# Kopieer dit bestand naar .env en vul aan. .env wordt nooit gecommit (zie .gitignore).

# Optioneel: zonder key valt de chat automatisch terug op de regelgebaseerde demo-modus.
ANTHROPIC_API_KEY=

# Welk Claude-model de chat gebruikt. Standaard het krachtigste model; zet op
# claude-sonnet-5 of claude-haiku-4-5 voor snellere/goedkopere demo-antwoorden.
CLAUDE_MODEL=claude-opus-5

# Zet op "true" om de /api/dev/login-as achterdeur te activeren (enkel nodig voor de
# security-demo/tests met de verborgen tweede klant). Laat op "false" in een echte omgeving.
DEMO_MODE=true
